 yt/index.html                |   2 +-
 5 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/click-joints/index.html b/click-joints/index.html
index 1da0714..1e7ee20 100644
--- a/click-joints/index.html
+++ b/click-joints/index.html
@@ -183,7 +183,7 @@
         </div>
         <figure class="frame" style="margin: 1.6rem 0 2rem">
           <span class="frame-media">
-            <img src="pro-rig.jpg" alt="Click Joints Pro in Blender: a rigged figure with a hinge at each elbow and knee and a ball joint at shoulders, hips and neck, a degree number at every joint, and the joint list in the panel." width="1600" height="900" loading="lazy" />
+            <img src="pro-rig.jpg" alt="Click Joints Pro, before and after: a rigged figure with its armature, and the same figure as printable parts with a hinge at each elbow and knee and ball joints at shoulders, hips and neck." width="1600" height="900" loading="lazy" />
           </span>
           <figcaption><strong>Figure from rig in Pro.</strong> Screenshot from Blender 5.3: nine joints from one button.</figcaption>
         </figure>
