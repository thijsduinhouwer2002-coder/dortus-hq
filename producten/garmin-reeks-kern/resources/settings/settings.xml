<resources>
    <!-- Wat de drager kiest in Garmin Connect of de Connect IQ-app. Thema: 0 Dusk, 1 Tide, 2 Kelp, 3 Night (Thema.mc). -->
    <properties>
        <property id="Thema" type="number">1</property>
    </properties>
    <settings>
        <setting propertyKey="@Properties.Thema" title="@Strings.ThemaTitel">
            <settingConfig type="list">
                <listEntry value="0">@Strings.ThemaDusk</listEntry>
                <listEntry value="1">@Strings.ThemaTide</listEntry>
                <listEntry value="2">@Strings.ThemaKelp</listEntry>
                <listEntry value="3">@Strings.ThemaNight</listEntry>
            </settingConfig>
        </setting>
    </settings>
</resources>
