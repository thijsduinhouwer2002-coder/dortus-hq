# Alleen voor de bouwstraat: één schermafbeelding van de gratis versie (wit, wakker, slaap zoals proef.jungle),
# met het manifest van de gratis versie en zonder de map betaald. Niet voor de winkel.
project.manifest = manifest-gratis.xml
project.typecheck = 1
base.excludeAnnotations = winkel;betaald
# De map gratis bevat alleen de naam op het horloge (Skiff Free).
base.resourcePath = $(base.resourcePath);gratis
