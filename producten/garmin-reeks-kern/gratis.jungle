# De gratis versie voor de winkel: eigen manifest (eigen app-id), geen instellingen (de map betaald doet niet mee),
# één vast thema en drie vaste velden (zie source/Soort.mc). Blijft altijd gratis, geen proef en geen code.
project.manifest = manifest-gratis.xml
project.typecheck = 1
base.excludeAnnotations = proef;betaald
# De map gratis bevat alleen de naam op het horloge (Skiff Free).
base.resourcePath = $(base.resourcePath);gratis
