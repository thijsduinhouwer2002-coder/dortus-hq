/* Scanner voor de rekenmachine. */ -> FLEX_BLOCK_COMMENT
%{ -> FLEX_SECTION
#include -> FLEX_C_PREPROCESSOR
"calc.tab.h" -> FLEX_STRING
%} -> FLEX_SECTION
%option -> FLEX_DIRECTIVE
noyywrap -> FLEX_IDENTIFIER
DIGIT -> FLEX_DEFINITION
[0-9] -> FLEX_REGEX_CLASS
%% -> FLEX_SECTION
{DIGIT} -> FLEX_REGEX_REFERENCE
+ -> FLEX_REGEX_OPERATOR
( -> FLEX_REGEX_OPERATOR
"." -> FLEX_STRING
{DIGIT} -> FLEX_REGEX_REFERENCE
* -> FLEX_REGEX_OPERATOR
) -> FLEX_REGEX_OPERATOR
? -> FLEX_REGEX_OPERATOR
{ -> FLEX_BRACES
yylval -> FLEX_FLEX_MACRO
= -> FLEX_OPERATOR
atof -> -
( -> FLEX_PARENTHESES
yytext -> FLEX_FLEX_MACRO
) -> FLEX_PARENTHESES
; -> FLEX_SEMICOLON
return -> FLEX_C_KEYWORD
NUM -> FLEX_TOKEN
; -> FLEX_SEMICOLON
} -> FLEX_BRACES
[-+*/()\n] -> FLEX_REGEX_CLASS
{ -> FLEX_BRACES
return -> FLEX_C_KEYWORD
yytext -> FLEX_FLEX_MACRO
[ -> FLEX_BRACKETS
0 -> FLEX_NUMBER
] -> FLEX_BRACKETS
; -> FLEX_SEMICOLON
} -> FLEX_BRACES
[ \t] -> FLEX_REGEX_CLASS
+ -> FLEX_REGEX_OPERATOR
; -> FLEX_SEMICOLON
/* spaties overslaan */ -> FLEX_BLOCK_COMMENT
. -> FLEX_REGEX_OPERATOR
{ -> FLEX_BRACES
fprintf -> -
( -> FLEX_PARENTHESES
stderr -> -
, -> FLEX_COMMA
"onbekend teken: %s\n" -> FLEX_STRING
, -> FLEX_COMMA
yytext -> FLEX_FLEX_MACRO
) -> FLEX_PARENTHESES
; -> FLEX_SEMICOLON
} -> FLEX_BRACES
%% -> FLEX_SECTION
