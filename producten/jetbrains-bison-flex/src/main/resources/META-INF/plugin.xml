<idea-plugin>
    <id>com.dortus.bisonflex</id>
    <name>Bison &amp; Flex Support</name>
    <vendor email="thijs@dortus.com" url="https://dortus.com">Dortus</vendor>
    <description><![CDATA[
    Language support for Bison/Yacc grammars (<code>.y</code>, <code>.yy</code>) and
    Flex/Lex scanners (<code>.l</code>, <code>.ll</code>). Early version: file types and syntax highlighting with your color scheme.
    ]]></description>
    <!-- Freemium: zonder licentie werkt het gratis deel, Pro vraagt PBISONFLEX (ontwerp.md, eis 8).
         release-date is voorlopig; die wordt op de lanceerdag gezet (architectuur.md). -->
    <product-descriptor code="PBISONFLEX" release-date="20261215" release-version="20261" optional="true"/>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Bison" implementationClass="com.dortus.bisonflex.BisonFileType" fieldName="INSTANCE"
                  language="BisonFlex.Bison" extensions="y;yy"/>
        <fileType name="Flex" implementationClass="com.dortus.bisonflex.FlexFileType" fieldName="INSTANCE"
                  language="BisonFlex.Flex" extensions="l;ll"/>
        <lang.parserDefinition language="BisonFlex.Bison" implementationClass="com.dortus.bisonflex.BisonParserDefinition"/>
        <lang.parserDefinition language="BisonFlex.Flex" implementationClass="com.dortus.bisonflex.FlexParserDefinition"/>
        <lang.syntaxHighlighterFactory language="BisonFlex.Bison" implementationClass="com.dortus.bisonflex.BisonHighlighterFactory"/>
        <lang.syntaxHighlighterFactory language="BisonFlex.Flex" implementationClass="com.dortus.bisonflex.FlexHighlighterFactory"/>
        <colorSettingsPage implementation="com.dortus.bisonflex.BisonKleurenPagina"/>
        <colorSettingsPage implementation="com.dortus.bisonflex.FlexKleurenPagina"/>
        <lang.commenter language="BisonFlex.Bison" implementationClass="com.dortus.bisonflex.BisonCommenter"/>
        <lang.commenter language="BisonFlex.Flex" implementationClass="com.dortus.bisonflex.FlexCommenter"/>
        <lang.foldingBuilder language="BisonFlex.Bison" implementationClass="com.dortus.bisonflex.BisonFolding"/>
        <lang.foldingBuilder language="BisonFlex.Flex" implementationClass="com.dortus.bisonflex.FlexFolding"/>
        <lang.psiStructureViewFactory language="BisonFlex.Bison" implementationClass="com.dortus.bisonflex.BisonStructuur"/>
        <lang.psiStructureViewFactory language="BisonFlex.Flex" implementationClass="com.dortus.bisonflex.FlexStructuur"/>
        <notificationGroup id="Bison &amp; Flex Pro" displayType="BALLOON"/>
        <gotoDeclarationHandler implementation="com.dortus.bisonflex.pro.GaNaarDefinitie"/>
        <lang.findUsagesProvider language="BisonFlex.Bison" implementationClass="com.dortus.bisonflex.psi.BisonAllePlekken"/>
        <lang.findUsagesProvider language="BisonFlex.Flex" implementationClass="com.dortus.bisonflex.psi.FlexAllePlekken"/>
        <!-- Pro-regel bij hernoemen: niet half hernoemen zonder licentie (ProHernoemen.kt). -->
        <renamePsiElementProcessor implementation="com.dortus.bisonflex.pro.ProHernoemen" order="first"/>
        <!-- Shift+F6 op een token in scannercode zonder licentie: melding in plaats van de IDE-fout (ProHernoemenScanner.kt). -->
        <renameHandler implementation="com.dortus.bisonflex.pro.ProHernoemenScanner" order="first"/>
    </extensions>
    <applicationListeners>
        <!-- Weet of er een echte ga-naar-actie bezig is, zodat Ctrl+zweven geen Pro-melding geeft (GaNaarActie.kt). -->
        <listener class="com.dortus.bisonflex.pro.GaNaarActie" topic="com.intellij.openapi.actionSystem.ex.AnActionListener"/>
    </applicationListeners>
</idea-plugin>
