<idea-plugin>
    <id>com.dortus.bisonflex</id>
    <name>Bison &amp; Flex</name>
    <vendor email="thijs@dortus.com" url="https://dortus.com">Dortus</vendor>
    <!-- Winkeltekst uit commercie/jetbrains-bison-flex/indienen.md (Chris, 8 nov). CLion staat erin sinds de CLion-test groen is (run 42450473711). -->
    <description><![CDATA[
<p>Bison/Yacc and Flex/Lex files in the IDE: highlighting, errors, navigation and rename.
For <code>.y</code>, <code>.yy</code>, <code>.l</code> and <code>.ll</code> files in CLion and other JetBrains IDEs.
Made for C and C++ developers who write parsers and lexers.</p>

<p><b>Free</b></p>
<ul>
  <li>Bison, Yacc, Flex and Lex file types with their own icons</li>
  <li>Highlighting for directives, tokens, rules, start conditions and regular expressions,
      using your color scheme (light, dark and any theme)</li>
  <li>C code in actions highlighted: keywords, strings, comments and
      <code>$$</code>, <code>$1</code>, <code>@1</code></li>
  <li>Syntax errors in the grammar and the scanner</li>
  <li>Folding and a Structure view with rules, tokens and start conditions</li>
  <li>Comment and uncomment with the usual shortcut</li>
  <li>Go to definition, find usages and rename within a file
      (renaming a token your scanner also uses is Pro)</li>
</ul>

<p><b>Pro</b> (free 30-day trial, then a paid license): your grammar and scanner, connected.</p>
<ul>
  <li>Jump from a token in the scanner (<code>.l</code>) to its <code>%token</code>
      in the grammar (<code>.y</code>)</li>
  <li>Find usages and rename tokens across grammar and scanner at once</li>
  <li>Warnings for undefined symbols and start conditions, and for unused rules,
      tokens and start conditions, with a quick fix to remove the unused ones</li>
</ul>

<p>The free features keep working after the trial. No sign-up with us, no telemetry.</p>

<p>Another plugin for <code>.y</code> files installed? Disable it, so the IDE uses this one.</p>

<p>Questions or a bug: <a href="mailto:thijs@dortus.com">thijs@dortus.com</a>.
More at <a href="https://dortus.com/bison-flex/">dortus.com/bison-flex</a>.</p>
    ]]></description>
    <change-notes><![CDATA[
<p>2026.1.1: when the IDE has no Register dialog, "Start free trial" in the Pro notification now opens the Bison &amp; Flex page on JetBrains Marketplace.</p>
<p>2026.1.0: first release. Bison/Yacc and Flex/Lex file types, highlighting, syntax errors,
folding, Structure view, and go to definition, find usages and rename within a file.
Pro: navigation, find usages and rename of tokens across grammar and scanner,
and warnings for undefined and unused names, with a quick fix to remove unused ones.</p>
    ]]></change-notes>
    <!-- Freemium: zonder licentie werkt het gratis deel, Pro vraagt PBISONFLEX (ontwerp.md, eis 8).
         release-date is voorlopig (vandaag of eerder: Plugin Verifier en Marketplace weigeren meer dan 5 dagen vooruit); op de lanceerdag zetten (architectuur.md). -->
    <product-descriptor code="PBISONFLEX" release-date="20261108" release-version="20261" optional="true"/>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Bison" implementationClass="com.dortus.bisonflex.BisonFileType" fieldName="INSTANCE"
                  language="BisonFlex.Bison" extensions="y;yy"/>
        <fileType name="Flex" implementationClass="com.dortus.bisonflex.FlexFileType" fieldName="INSTANCE"
                  language="BisonFlex.Flex" extensions="l;ll"/>
        <lang.parserDefinition language="BisonFlex.Bison" implementationClass="com.dortus.bisonflex.BisonParserDefinition"/>
        <lang.parserDefinition language="BisonFlex.Flex" implementationClass="com.dortus.bisonflex.FlexParserDefinition"/>
        <lang.syntaxHighlighterFactory language="BisonFlex.Bison" implementationClass="com.dortus.bisonflex.BisonHighlighterFactory"/>
        <lang.syntaxHighlighterFactory language="BisonFlex.Flex" implementationClass="com.dortus.bisonflex.FlexHighlighterFactory"/>
        <colorSettingsPage implementation="com.dortus.bisonflex.BisonKleurenPagina"/>
        <colorSettingsPage implementation="com.dortus.bisonflex.FlexKleurenPagina"/>
        <lang.commenter language="BisonFlex.Bison" implementationClass="com.dortus.bisonflex.BisonCommenter"/>
        <lang.commenter language="BisonFlex.Flex" implementationClass="com.dortus.bisonflex.FlexCommenter"/>
        <lang.foldingBuilder language="BisonFlex.Bison" implementationClass="com.dortus.bisonflex.BisonFolding"/>
        <lang.foldingBuilder language="BisonFlex.Flex" implementationClass="com.dortus.bisonflex.FlexFolding"/>
        <lang.psiStructureViewFactory language="BisonFlex.Bison" implementationClass="com.dortus.bisonflex.BisonStructuur"/>
        <lang.psiStructureViewFactory language="BisonFlex.Flex" implementationClass="com.dortus.bisonflex.FlexStructuur"/>
        <notificationGroup id="Bison &amp; Flex Pro" displayType="BALLOON"/>
        <gotoDeclarationHandler implementation="com.dortus.bisonflex.pro.GaNaarDefinitie"/>
        <lang.findUsagesProvider language="BisonFlex.Bison" implementationClass="com.dortus.bisonflex.psi.BisonAllePlekken"/>
        <lang.findUsagesProvider language="BisonFlex.Flex" implementationClass="com.dortus.bisonflex.psi.FlexAllePlekken"/>
        <!-- Pro-regel bij hernoemen: niet half hernoemen zonder licentie (ProHernoemen.kt). -->
        <renamePsiElementProcessor implementation="com.dortus.bisonflex.pro.ProHernoemen" order="first"/>
        <!-- Shift+F6 op een token in scannercode zonder licentie: melding in plaats van de IDE-fout (ProHernoemenScanner.kt). -->
        <renameHandler implementation="com.dortus.bisonflex.pro.ProHernoemenScanner" order="first"/>
        <!-- Eis 7 (Pro): ongedefinieerd en ongebruikt (meldingen/Meldingen.kt). -->
        <localInspection language="BisonFlex.Bison" shortName="BisonOngedefinieerd" displayName="Undefined symbol" groupName="Bison &amp; Flex"
                         enabledByDefault="true" level="WARNING" implementationClass="com.dortus.bisonflex.meldingen.BisonOngedefinieerd"/>
        <localInspection language="BisonFlex.Bison" shortName="BisonOngebruikt" displayName="Unused rule or token" groupName="Bison &amp; Flex"
                         enabledByDefault="true" level="WEAK WARNING" implementationClass="com.dortus.bisonflex.meldingen.BisonOngebruikt"/>
        <localInspection language="BisonFlex.Flex" shortName="FlexOngedefinieerd" displayName="Undefined start condition" groupName="Bison &amp; Flex"
                         enabledByDefault="true" level="WARNING" implementationClass="com.dortus.bisonflex.meldingen.FlexOngedefinieerd"/>
        <localInspection language="BisonFlex.Flex" shortName="FlexOngebruikt" displayName="Unused start condition" groupName="Bison &amp; Flex"
                         enabledByDefault="true" level="WEAK WARNING" implementationClass="com.dortus.bisonflex.meldingen.FlexOngebruikt"/>
        <postStartupActivity implementation="com.dortus.bisonflex.meldingen.StandLuisteraar"/>
    </extensions>
    <applicationListeners>
        <!-- Weet of er een echte ga-naar-actie bezig is, zodat Ctrl+zweven geen Pro-melding geeft (GaNaarActie.kt). -->
        <listener class="com.dortus.bisonflex.pro.GaNaarActie" topic="com.intellij.openapi.actionSystem.ex.AnActionListener"/>
    </applicationListeners>
</idea-plugin>
