{
  "permissions": {
    "allow": [
      "WebSearch"
    ],
    "deny": [
      "WebFetch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash organisatie/start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/organisatie/controle/check_bestand.py",
            "timeout": 15,
            "statusMessage": "Controle openbare repo..."
          }
        ]
      }
    ]
  }
}
